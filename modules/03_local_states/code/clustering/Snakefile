rule project_sensitivity:
    input:
        prepared=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/prepared/.ok",
        matrix=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/prepared/log1p_gex.npz",
        cells=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/prepared/cells.tsv.gz",
        pca_model=f"{BASE}/{{dataset}}/scopes/{{scope}}/embedding/pca_model.npz",
        primary_pca=f"{BASE}/{{dataset}}/scopes/{{scope}}/embedding/pca.npy",
        clusters=f"{BASE}/{{dataset}}/scopes/{{scope}}/frozen/cell_clusters.tsv.gz",
        umap=f"{BASE}/{{dataset}}/scopes/{{scope}}/visual/umap_coordinates.tsv.gz",
        study_config=study_config_path
    output:
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/projection/.ok",
        summary=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/projection/summary.json",
        table=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/projection/sensitivity_projection.tsv.gz",
        figure=f"{BASE}/{{dataset}}/scopes/{{scope}}/sensitivity/projection/sensitivity_projection.png"
    threads: 8
    resources:
        mem_mb=int(config["resources"]["diagnostic_mem_mb"])
    params:
        neighbors=int(config["diagnostics"]["projection_neighbors"]),
        quantile=float(config["diagnostics"]["projection_support_quantile"]),
        components=lambda wc: int(STUDY_CONFIGS[wc.dataset]["scopes"][wc.scope]["pipeline"]["pca_n_components_used"]),
        seed=int(config["selection"]["seed"]),
        max_cells=int(config["diagnostics"]["umap_max_points_per_panel"])
    shell:
        "OPENBLAS_NUM_THREADS={threads} OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads} NUMBA_NUM_THREADS={threads} "
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/project_sensitivity.py "
        "--sensitivity-matrix {input.matrix} --sensitivity-cells {input.cells} --pca-model {input.pca_model} "
        "--primary-pca {input.primary_pca} --primary-clusters {input.clusters} --primary-umap {input.umap} "
        "--neighbors {params.neighbors} --support-quantile {params.quantile} "
        "--pca-components-used {params.components} --seed {params.seed} --threads {threads} "
        "--max-plot-cells {params.max_cells} "
        "--output-dir {BASE}/{wildcards.dataset}/scopes/{wildcards.scope}/sensitivity/projection"


