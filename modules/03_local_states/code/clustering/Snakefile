from pathlib import Path
import math
import yaml


BUNDLE = Path(workflow.basedir).resolve()
SCRIPTS = BUNDLE / "scripts"
PROJECT_CONFIG = Path(config.get("project_config_path", BUNDLE / "config.yaml")).resolve()
BASE = config["output_root"]
PYTHON = config["python"]
PYTHONPATH = f"{BUNDLE / 'vendor'}:{SCRIPTS}"

STUDY_CONFIG_PATHS = {
    dataset: (BUNDLE / path).resolve()
    for dataset, path in config["dataset_configs"].items()
}
STUDY_CONFIGS = {
    dataset: yaml.safe_load(path.read_text(encoding="utf-8"))
    for dataset, path in STUDY_CONFIG_PATHS.items()
}
DATASETS = sorted(STUDY_CONFIGS)
UNITS = [
    (dataset, scope)
    for dataset in DATASETS
    for scope in sorted(STUDY_CONFIGS[dataset]["scopes"])
]
ALL_SCOPES = sorted({scope for _, scope in UNITS})
SWEEP_SHARDS = [f"{index:03d}" for index in range(int(config["selection"]["n_shards"]))]


def study_config_path(wildcards):
    return str(STUDY_CONFIG_PATHS[wildcards.dataset])


def scope_release_markers(dataset):
    return [f"{BASE}/{dataset}/scopes/{scope}/release/.ok" for scope in sorted(STUDY_CONFIGS[dataset]["scopes"])]


def evaluation_target_cells(wildcards):
    selection = config["selection"]
    full_n = int(STUDY_CONFIGS[wildcards.dataset]["scopes"][wildcards.scope]["n_cells"])
    if "target_evaluation_fraction" not in selection:
        return min(full_n, int(selection["max_evaluation_cells"]))
    target = max(
        int(selection["min_evaluation_cells"]),
        math.ceil(full_n * float(selection["target_evaluation_fraction"])),
    )
    return min(full_n, int(selection["max_evaluation_cells"]), target)


wildcard_constraints:
    dataset="|".join(DATASETS),
    scope="|".join(ALL_SCOPES),
    shard="|".join(SWEEP_SHARDS)


rule all:
    input:
        f"{BASE}/cell_registry/.ok"


rule preflight:
    input:
        study_config=study_config_path
    output:
        report=f"{BASE}/{{dataset}}/scopes/{{scope}}/preflight/report.json",
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/preflight/.ok"
    threads: 1
    resources:
        mem_mb=int(config["resources"]["preflight_mem_mb"])
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/preflight.py "
        "--config {input.study_config} --scope {wildcards.scope} "
        "--report {output.report} --marker {output.marker}"


rule prepare_scope:
    input:
        preflight=f"{BASE}/{{dataset}}/scopes/{{scope}}/preflight/.ok",
        study_config=study_config_path
    output:
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/prepared/.ok",
        matrix=f"{BASE}/{{dataset}}/scopes/{{scope}}/prepared/log1p_gex.npz",
        cells=f"{BASE}/{{dataset}}/scopes/{{scope}}/prepared/cells.tsv.gz",
        features=f"{BASE}/{{dataset}}/scopes/{{scope}}/prepared/features.tsv.gz"
    threads: 4
    resources:
        mem_mb=int(config["resources"]["prepare_mem_mb"])
    shell:
        "OPENBLAS_NUM_THREADS={threads} OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads} "
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/prepare_scope.py "
        "--config {input.study_config} --scope {wildcards.scope} "
        "--output-root {BASE}/{wildcards.dataset}"


