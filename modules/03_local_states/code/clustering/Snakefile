rule resolution_shard:
    input:
        cohort=f"{BASE}/{{dataset}}/scopes/{{scope}}/cohort/.ok",
        embedding=f"{BASE}/{{dataset}}/scopes/{{scope}}/embedding/.ok",
        study_config=study_config_path,
        project_config=str(PROJECT_CONFIG)
    output:
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/shards/{{shard}}/.ok",
        partitions=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/shards/{{shard}}/partitions.npz",
        manifest=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/shards/{{shard}}/manifest.tsv"
    threads: 1
    resources:
        mem_mb=int(config["resources"]["sweep_shard_mem_mb"])
    params:
        shard_index=lambda wildcards: int(wildcards.shard),
        n_shards=len(SWEEP_SHARDS)
    shell:
        "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMBA_NUM_THREADS=1 "
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/resolution_shard.py "
        "--study-config {input.study_config} --project-config {input.project_config} "
        "--scope {wildcards.scope} --output-root {BASE}/{wildcards.dataset} "
        "--shard-index {params.shard_index} --n-shards {params.n_shards} --threads {threads}"


rule merge_resolution_sweep:
    input:
        full=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/full/full_labels.npz",
        shards=lambda wildcards: expand(
            f"{BASE}/{wildcards.dataset}/scopes/{wildcards.scope}/sweep/shards/{{shard}}/partitions.npz",
            shard=SWEEP_SHARDS,
        ),
        manifests=lambda wildcards: expand(
            f"{BASE}/{wildcards.dataset}/scopes/{wildcards.scope}/sweep/shards/{{shard}}/manifest.tsv",
            shard=SWEEP_SHARDS,
        ),
        project_config=str(PROJECT_CONFIG)
    output:
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/.ok",
        partitions=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/partitions.npz"
    threads: 1
    resources:
        mem_mb=int(config["resources"]["sweep_merge_mem_mb"])
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/merge_resolution_sweep.py "
        "--full {input.full} --shards {input.shards} --manifests {input.manifests} "
        "--project-config {input.project_config} "
        "--output-dir {BASE}/{wildcards.dataset}/scopes/{wildcards.scope}/sweep"


