    threads: 4
    resources:
        mem_mb=int(config["resources"]["diagnostic_mem_mb"])
    params:
        cell_cycle=float(config["diagnostics"]["maximum_cell_cycle_polarization_without_review"]),
        positive_program=float(config["diagnostics"]["maximum_positive_program_mean_without_review"])
    shell:
        "OPENBLAS_NUM_THREADS={threads} OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads} "
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/program_audit.py "
        "--matrix {input.matrix} --features {input.features} --clusters {input.clusters} "
