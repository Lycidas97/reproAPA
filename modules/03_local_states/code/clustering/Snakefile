rule full_partition_audit:
    input:
        evaluation=f"{BASE}/{{dataset}}/scopes/{{scope}}/sweep/full_partitions.tsv.gz",
        decision=f"{BASE}/{{dataset}}/scopes/{{scope}}/selection/selected_resolution.json",
        clusters=f"{BASE}/{{dataset}}/scopes/{{scope}}/frozen/cell_clusters.tsv.gz"
    output:
        marker=f"{BASE}/{{dataset}}/scopes/{{scope}}/full_partition_audit/.ok",
        summary=f"{BASE}/{{dataset}}/scopes/{{scope}}/full_partition_audit/summary.json",
        clusters=f"{BASE}/{{dataset}}/scopes/{{scope}}/full_partition_audit/cluster_transfer_audit.tsv",
        figure=f"{BASE}/{{dataset}}/scopes/{{scope}}/full_partition_audit/evaluation_to_full_transfer.png"
    threads: 1
    resources:
        mem_mb=16000
    params:
        minimum=int(config["diagnostics"]["minimum_cluster_cells"]),
        eval_minimum=int(config["diagnostics"]["minimum_evaluation_cluster_cells"]),
        ari=float(config["diagnostics"]["minimum_transfer_ari"]),
        jaccard=float(config["diagnostics"]["minimum_cluster_transfer_jaccard"]),
        purity=float(config["diagnostics"]["minimum_cluster_transfer_purity"]),
        recall=float(config["diagnostics"]["minimum_cluster_transfer_recall"]),
        drift=float(config["diagnostics"]["maximum_cluster_count_drift_fraction"])
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/full_partition_audit.py "
        "--evaluation-partitions {input.evaluation} --selected-json {input.decision} "
        "--frozen-clusters {input.clusters} --minimum-cluster-cells {params.minimum} "
        "--minimum-evaluation-cluster-cells {params.eval_minimum} --minimum-transfer-ari {params.ari} "
        "--minimum-cluster-jaccard {params.jaccard} --minimum-cluster-purity {params.purity} "
        "--minimum-cluster-recall {params.recall} --maximum-cluster-count-drift-fraction {params.drift} "
        "--output-dir {BASE}/{wildcards.dataset}/scopes/{wildcards.scope}/full_partition_audit"


