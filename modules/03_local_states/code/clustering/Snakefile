        "--scope-root {BASE}/{wildcards.dataset}/scopes/{wildcards.scope}"


rule dataset_release:
    input:
        lambda wildcards: scope_release_markers(wildcards.dataset)
    output:
        marker=f"{BASE}/{{dataset}}/release/.ok",
        table=f"{BASE}/{{dataset}}/release/dataset_release.tsv"
    threads: 1
    resources:
        mem_mb=4000
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/aggregate_release.py "
        "--output-root {BASE} --dataset {wildcards.dataset} --output-dir {BASE}/{wildcards.dataset}/release"


rule project_release:
    input:
        expand(f"{BASE}/{{dataset}}/release/.ok", dataset=DATASETS)
    output:
        marker=f"{BASE}/release/.ok",
        table=f"{BASE}/release/project_release.tsv"
    threads: 1
    resources:
        mem_mb=4000
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/aggregate_release.py "
        "--output-root {BASE} --output-dir {BASE}/release"


rule clustering_cell_registry:
    input:
        project_release=f"{BASE}/release/.ok",
        scope_releases=expand(f"{BASE}/{{dataset}}/scopes/studywide/release/scope_release.json", dataset=DATASETS),
        primary_cells=expand(f"{BASE}/{{dataset}}/scopes/studywide/prepared/cells.tsv.gz", dataset=DATASETS),
        primary=expand(f"{BASE}/{{dataset}}/scopes/studywide/frozen/cell_clusters.tsv.gz", dataset=DATASETS),
        primary_programs=expand(f"{BASE}/{{dataset}}/scopes/studywide/program_audit/cell_program_scores.tsv.gz", dataset=DATASETS),
        cluster_programs=expand(f"{BASE}/{{dataset}}/scopes/studywide/program_audit/cluster_program_scores.tsv", dataset=DATASETS),
        cluster_transfer=expand(f"{BASE}/{{dataset}}/scopes/studywide/full_partition_audit/cluster_transfer_audit.tsv", dataset=DATASETS),
        sensitivity_cells=expand(f"{BASE}/{{dataset}}/scopes/studywide/sensitivity/prepared/cells.tsv.gz", dataset=DATASETS),
        sensitivity=expand(f"{BASE}/{{dataset}}/scopes/studywide/sensitivity/projection/sensitivity_projection.tsv.gz", dataset=DATASETS)
    output:
        marker=f"{BASE}/cell_registry/.ok",
        registry=f"{BASE}/cell_registry/clustering_cell_registry.tsv.gz",
        summary=f"{BASE}/cell_registry/summary.json",
        datasets=f"{BASE}/cell_registry/dataset_summary.tsv"
    threads: 2
    resources:
        mem_mb=32000
    params:
        datasets=" ".join(DATASETS)
    shell:
        "PYTHONPATH={PYTHONPATH} {PYTHON} {SCRIPTS}/compile_cell_registry.py "
        "--output-root {BASE} --datasets {params.datasets} --output-dir {BASE}/cell_registry"
