    "function_excerpts": {
      "_reference_cache_payload": "def _reference_cache_payload(gtf_path, chrom_map_path, transcript_end_zones_bp, gene_downstream_bp):\n    return {\n        \"schema\": 3,\n        \"gtf\": _file_signature(gtf_path),\n        \"chromosome_map\": _file_signature(chrom_map_path),\n        \"transcript_end_zones_bp\": [int(value) for value in transcript_end_zones_bp],\n        \"gene_downstream_bp\": int(gene_downstream_bp),\n    }",
      "generate_annotation_candidates": "def generate_annotation_candidates(pas_map, intervals, cut_site_window_bp=25, bedtools=\"bedtools\"):\n    from .annotation_bedtools import BedtoolsCandidateIndex\n    import sys\n\n    with BedtoolsCandidateIndex(sys.modules[__name__], intervals, bedtools) as index:\n        return index.generate(pas_map, cut_site_window_bp)",
      "choose_primary_assignments": "def choose_primary_assignments(pas_map: pd.DataFrame, candidates: pd.DataFrame) -> pd.DataFrame:\n    from .assignment_batch import choose_primary_assignments_batch\n    import sys\n\n    return choose_primary_assignments_batch(sys.modules[__name__], pas_map, candidates)"
    },
